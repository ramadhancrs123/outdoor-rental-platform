# Supabase — salin ke .env lalu isi dengan nilai project kamu
VITE_SUPABASE_PROJECT_REF=<project-ref>
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon jwt key>
# Key publishable modern — hanya dipakai jika VITE_SUPABASE_ANON_KEY kosong
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Legacy REST data provider (Refine simple-rest) — fallback bila Supabase belum dikonfigurasi
VITE_API_URL=https://api.fake-rest.refine.dev
